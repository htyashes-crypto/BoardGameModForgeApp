{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModForge",
  "version": "2.0.0",
  "identifier": "com.actframework.modforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "ModForge",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NDcwQTAyNkMyQzM4OUEKUldTYU9DeHNBZ3BIaExXUDBIN1FNbDhMbFg1U0cxMUZwaHlZRzMrZ1RyWENZR1o0SkhOaUV5U1EK",
      "endpoints": [
        "https://github.com/htyashes-crypto/BoardGameModForgeApp/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
